# Supabase (temporary DB, will be replaced by AWS later)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Groq (AI calls). Model used: llama-3.1-8b-instant
GROQ_API_KEY=

# OpenRouter — currently unused (blocks requests when account balance is negative,
# even for free models). Kept here in case we switch back; see src/ai/client.ts.
OPENROUTER_API_KEY=

# Telegram Bot API (temporary customer channel, will be replaced by an in-app widget)
TELEGRAM_BOT_TOKEN=

# Withdrawal-delay feed, polled every POLL_INTERVAL_MINUTES
WITHDRAWAL_FEED_URL=

# Optional testing/staging helpers. Leave both blank in production.
# TEST_USER_IDS: comma-separated userIds. If set, only these customers are processed.
TEST_USER_IDS=
# TEST_TELEGRAM_CHAT_ID: fallback chat id used when a conversation has no
# telegram_chat_id linked yet, so outbound messages have somewhere to land during testing.
TEST_TELEGRAM_CHAT_ID=

# Server
PORT=3000
POLL_INTERVAL_MINUTES=2
